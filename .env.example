# Telegram (mismo token y chat_id que el Death Scanner)
TELEGRAM_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# MEXC API Keys (futures.mexc.com → API Management)
MEXC_API_KEY=tu_api_key_aqui
MEXC_API_SECRET=tu_api_secret_aqui

# Config del bot
TRADE_SIZE=5
LEVERAGE=3
SCORE_MIN=90
MAX_POSITIONS=4

# Google Sheets (opcional pero recomendado)
GOOGLE_SHEET_ID=id_de_tu_hoja
GOOGLE_CREDENTIALS={"type":"service_account",...}
